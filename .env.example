# =============================================================================
# LandGate 环境变量模板
# 复制为 .env 并填入真实值（.env 已被 .gitignore 排除，不会提交到 Git）
# =============================================================================

# ---- Spring ----
SPRING_PROFILES_ACTIVE=test
SERVER_PORT=8080

# ---- MySQL ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=sub2api
DB_USER=root
DB_PASSWORD=change_me_db_password

# ---- Redis ----
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=change_me_redis_password

# ---- SMTP 邮件 ----
# test 环境: 用 Mailhog (docker run -d --name mailhog -p 1025:1025 -p 8025:8025 mailhog/mailhog)
# prod 环境: 填写真实 SMTP 服务器和认证信息
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
# SMTP_USERNAME=
# SMTP_PASSWORD=

# ---- JWT 签名密钥（至少 32 字符; openssl rand -base64 32 生成） ----
JWT_SIGNING_KEY=change_me_jwt_signing_key_at_least_32_chars

# ---- AES-256 加密密钥（64 位 Hex; openssl rand -hex 32 生成） ----
CREDENTIAL_ENCRYPTION_KEY=change_me_credential_encryption_key_64_hex_chars

# ---- 初始管理员账号（首次启动自动创建；已存在时默认不重置密码） ----
LANDGATE_ADMIN_EMAIL=admin@example.com
LANDGATE_ADMIN_PASSWORD=change_me_admin_password
LANDGATE_ADMIN_USERNAME=Administrator
# LANDGATE_ADMIN_RESET_PASSWORD=false

# ---- CAPTCHA 人机验证（test 默认关闭，prod 开启） ----
# CAPTCHA_ENABLED=false
# TURNSTILE_SECRET_KEY=your-turnstile-secret-key

# ---- 注册频率限制（每小时每IP最大注册次数） ----
# REGISTER_RATE_LIMIT=3

# ---- 请求体上限（可选，默认 64MB） ----
# GATEWAY_MAX_BODY_SIZE=67108864

# ---- OAuth 凭证自动获取 ----
# Anthropic 和 OpenAI 均使用公共 client_id，无需注册应用
# 授权回调地址（需与 OAuth App 注册的 redirect_uri 一致）
# 默认使用 Codex CLI 的公共回调地址
# OAUTH_REDIRECT_URI=http://localhost:1455/auth/callback

# ---- Docker 镜像仓库（可选） ----
APP_IMAGE=crpi-j079zr32e4h7wn66.cn-shanghai.personal.cr.aliyuncs.com/laqcce
# DOCKER_HUB_USER=your-dockerhub-user
