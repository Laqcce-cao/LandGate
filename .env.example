# =============================================================================
# LandGate 环境变量模板
# 复制为 .env 并填入真实值（.env 已被 .gitignore 排除，不会提交到 Git）
# =============================================================================

# ---- Spring ----
SPRING_PROFILES_ACTIVE=test
SERVER_PORT=8080

# ---- MySQL ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=sub2api
DB_USER=root
DB_PASSWORD=change_me_db_password

# ---- Redis ----
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=change_me_redis_password

# ---- JWT 签名密钥（至少 32 字符; openssl rand -base64 32 生成） ----
JWT_SIGNING_KEY=change_me_jwt_signing_key_at_least_32_chars

# ---- AES-256 加密密钥（64 位 Hex; openssl rand -hex 32 生成） ----
CREDENTIAL_ENCRYPTION_KEY=change_me_credential_encryption_key_64_hex_chars

# ---- 请求体上限（可选，默认 64MB） ----
# GATEWAY_MAX_BODY_SIZE=67108864

# ---- Docker 镜像仓库（可选） ----
# APP_IMAGE=your-registry.example.com/landgate:latest
# DOCKER_HUB_USER=your-dockerhub-user
