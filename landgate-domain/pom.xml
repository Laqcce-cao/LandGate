<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.landgate</groupId>
        <artifactId>landgate</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>landgate-domain</artifactId>
    <packaging>jar</packaging>
    <name>LandGate :: Domain</name>
    <description>Core domain layer - entities, value objects, aggregates, repository interfaces, domain services.</description>

    <dependencies>
        <dependency>
            <groupId>com.landgate</groupId>
            <artifactId>landgate-types</artifactId>
        </dependency>
        <dependency>
            <groupId>com.landgate</groupId>
            <artifactId>landgate-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-lang3</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-context</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-tx</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>
        <!-- Redisson 核心（仅 RBucket 缓存，不含 Spring Boot 自动装配） -->
        <dependency>
            <groupId>org.redisson</groupId>
            <artifactId>redisson</artifactId>
            <version>${redisson.version}</version>
        </dependency>
    </dependencies>
</project>
