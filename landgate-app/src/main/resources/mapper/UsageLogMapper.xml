<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.landgate.infrastructure.dao.IUsageLogDao">

    <resultMap id="UsageLogResultMap" type="com.landgate.infrastructure.dao.po.UsageLogPO">
        <id     column="id"                      property="id"/>
        <result column="user_id"                 property="userId"/>
        <result column="api_key_id"              property="apiKeyId"/>
        <result column="account_id"              property="accountId"/>
        <result column="group_id"                property="groupId"/>
        <result column="subscription_id"         property="subscriptionId"/>
        <result column="request_id"              property="requestId"/>
        <result column="model"                   property="model"/>
        <result column="platform"                property="platform"/>
        <result column="requested_model"         property="requestedModel"/>
        <result column="upstream_model"          property="upstreamModel"/>
        <result column="billing_mode"            property="billingMode"/>
        <result column="input_tokens"            property="inputTokens"/>
        <result column="output_tokens"           property="outputTokens"/>
        <result column="cache_creation_tokens"   property="cacheCreationTokens"/>
        <result column="cache_read_tokens"       property="cacheReadTokens"/>
        <result column="input_cost"              property="inputCost"/>
        <result column="output_cost"             property="outputCost"/>
        <result column="cache_creation_cost"     property="cacheCreationCost"/>
        <result column="cache_read_cost"         property="cacheReadCost"/>
        <result column="total_cost"              property="totalCost"/>
        <result column="actual_cost"             property="actualCost"/>
        <result column="rate_multiplier"         property="rateMultiplier"/>
        <result column="account_rate_multiplier" property="accountRateMultiplier"/>
        <result column="stream"                  property="stream"/>
        <result column="duration_ms"             property="durationMs"/>
        <result column="first_token_ms"          property="firstTokenMs"/>
        <result column="user_agent"              property="userAgent"/>
        <result column="ip_address"              property="ipAddress"/>
        <result column="created_at"              property="createdAt"/>
    </resultMap>

    <!-- ==================== 基础 CRUD ==================== -->

    <select id="selectById" resultMap="UsageLogResultMap">
        SELECT * FROM usage_logs WHERE id = #{id}
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO usage_logs (
            user_id, api_key_id, account_id, group_id, subscription_id,
            request_id, model, platform, requested_model, upstream_model, billing_mode,
            input_tokens, output_tokens, cache_creation_tokens, cache_read_tokens,
            input_cost, output_cost, cache_creation_cost, cache_read_cost,
            total_cost, actual_cost, rate_multiplier, account_rate_multiplier,
            stream, duration_ms, first_token_ms, user_agent, ip_address, created_at
        ) VALUES (
            #{userId}, #{apiKeyId}, #{accountId}, #{groupId}, #{subscriptionId},
            #{requestId}, #{model}, #{platform}, #{requestedModel}, #{upstreamModel}, #{billingMode},
            #{inputTokens}, #{outputTokens}, #{cacheCreationTokens}, #{cacheReadTokens},
            #{inputCost}, #{outputCost}, #{cacheCreationCost}, #{cacheReadCost},
            #{totalCost}, #{actualCost}, #{rateMultiplier}, #{accountRateMultiplier},
            #{stream}, #{durationMs}, #{firstTokenMs}, #{userAgent}, #{ipAddress}, NOW()
        )
    </insert>

    <select id="selectAll" resultMap="UsageLogResultMap">
        SELECT * FROM usage_logs ORDER BY created_at DESC LIMIT #{size} OFFSET #{offset}
    </select>

    <select id="countAll" resultType="long">
        SELECT COUNT(*) FROM usage_logs
    </select>

    <!-- ==================== 业务查询（分页 + 降序） ==================== -->

    <select id="selectByUserId" resultMap="UsageLogResultMap">
        SELECT * FROM usage_logs
        WHERE user_id = #{userId}
        ORDER BY created_at DESC
        LIMIT #{size} OFFSET #{offset}
    </select>

    <select id="selectByApiKeyId" resultMap="UsageLogResultMap">
        SELECT * FROM usage_logs
        WHERE api_key_id = #{apiKeyId}
        ORDER BY created_at DESC
        LIMIT #{size} OFFSET #{offset}
    </select>

    <select id="selectByAccountId" resultMap="UsageLogResultMap">
        SELECT * FROM usage_logs
        WHERE account_id = #{accountId}
        ORDER BY created_at DESC
        LIMIT #{size} OFFSET #{offset}
    </select>

    <select id="countByUserId" resultType="long">
        SELECT COUNT(*) FROM usage_logs WHERE user_id = #{userId}
    </select>

    <select id="countByApiKeyId" resultType="long">
        SELECT COUNT(*) FROM usage_logs WHERE api_key_id = #{apiKeyId}
    </select>

    <select id="countByAccountId" resultType="long">
        SELECT COUNT(*) FROM usage_logs WHERE account_id = #{accountId}
    </select>

</mapper>
